{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Local Backend",
            "type": "shell",
            "command": "uv run web_solver_server.py"
        },
        {
            "label": "Local Frontend",
            "type": "shell",
            "command": "cd cluedo-web-solver && bun run dev"
        },
        {
            "label": "Deploy Backend",
            "type": "shell",
            "command": "ssh pi@192.168.2.28 'cd ~/python-cluedo/ && git fetch && git reset --hard origin/main && sudo systemctl restart cluedo-web-solver'"
        },
        {
            "label": "Build and Deploy Frontend",
            "type": "shell",
            "command": "cd cluedo-web-solver && bun run build && rsync -av --delete --rsync-path='sudo rsync' dist/ pi@192.168.2.28:/srv/cluedo-web-solver/dist/"
        }
    ]
}